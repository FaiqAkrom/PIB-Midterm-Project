# Port server backend
PORT=3001

# Broker MQTT
MQTT_BROKER=mqtt://broker.hivemq.com:1883

# Kredensial Supabase (Opsional: Jika dikosongkan, backend otomatis beralih ke Mode In-Memory Fallback untuk pengujian lokal)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Silo ID Default
DEFAULT_SILO_ID=silo-01

# Profil Budaya Default (sunda | jawa | indonesia_desa)
DEFAULT_CULTURE_PROFILE=sunda
