# Port server backend
PORT=3001

# Broker MQTT
MQTT_BROKER=mqtt://broker.hivemq.com:1883

# ─── OPSI DATABASE (pilih salah satu) ────────────────────────────────────────

# Opsi 1: PostgreSQL Lokal (PRIORITAS UTAMA jika diisi)
# Jalankan scripts/init_db.sql terlebih dahulu untuk membuat tabel
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/siloguard

# Opsi 2: Supabase — Postgres Terkelola (diabaikan jika DATABASE_URL aktif)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Jika kedua opsi kosong → backend otomatis pakai In-Memory Store (data hilang saat restart)

# ─────────────────────────────────────────────────────────────────────────────

# Silo ID Default
DEFAULT_SILO_ID=silo-01

# Profil Budaya Default (sunda | jawa | indonesia_desa)
DEFAULT_CULTURE_PROFILE=sunda
